# Copy to .env at the repo root before running scripts/pull-build-deploy.sh or
# docker compose -f docker-compose.prod.yml directly. Never commit the real .env.

# ---- Postgres ----
PG_USER=postgres
PG_PASSWORD=change-me
PG_DB=groupscape_db

# ---- Backend ----
# Any random string, used by the backend for hashing.
BACKEND_SECRET=change-me

# ---- Public origin ----
# URL (including http:// or https://) the frontend calls for API requests. Baked
# into the frontend container at startup (site/scripts/docker-entrypoint.sh), not
# at build time — so this can be changed without rebuilding the image.
HOST_URL=https://groupscape.example.com

# ---- Host port mappings (override if these collide with other services on the box) ----
WEB_PORT=3020
API_PORT=3021
DB_PORT=3022

# ---- Monitoring / dashboards (optional) ----
# Bearer-token guard on GET /api/vantage/ping, so a Vantage instance can poll this app's
# health. Leave unset to run the endpoint unauthenticated (acceptable for internal/dev
# only — set this in real production).
VANTAGE_API_KEY=change-me
# Static key (X-Api-Key header or ?apiKey= query param) guarding GET /api/homepage/stats,
# gethomepage.dev's flat customapi widget feed. Endpoint 503s until this is set.
HOMEPAGE_API_KEY=change-me
