HOST_URL=http://localhost:5000 # Set to the URL (including http// or https://) of the backend. This is used for API calls from the frontend.
PG_USER=postgres # This can be anything if using docker-compose, otherwise match it with the user in your external DB.
PG_PASSWORD=postgres # This can be anything if using docker-compose, otherwise match it with the password in your external DB.
PG_HOST=postgres # Only change this if you are connecting to an external postgres database.
PG_PORT=5432 # Only change this is if you are connecting to an external postgres database on a non-standard port.
PG_DB=groupscape_db # This can be anything if using docker-compose, otherwise match it with the table in your external DB.
BACKEND_SECRET=somerandomkey # This can be anything, generate a random secret using some generator. It is used by the backend for hashing.
VANTAGE_API_KEY= # Optional. Bearer-token guard on GET /api/vantage/ping, so a Vantage instance can poll this app's health. Leave unset to run the endpoint unauthenticated (dev only).
HOMEPAGE_API_KEY= # Optional. Static key (X-Api-Key header or ?apiKey= query param) guarding GET /api/homepage/stats, gethomepage.dev's flat customapi widget feed. Endpoint 503s until this is set.
ADMIN_TOKEN= # Optional. Any random string. Enables the admin panel (/admin) and is hashed at startup for auth. Leave unset to keep admin routes disabled (404).
WEB_ORIGIN= # Optional. The frontend's public origin (e.g. https://groupscape.example.com), used to redirect the browser back after Discord OAuth login completes. Required for DISCORD_* below to be useful.
DISCORD_CLIENT_ID= # Optional. Discord application client id. Leave any of the three DISCORD_* vars unset to keep Discord login disabled (503).
DISCORD_CLIENT_SECRET= # Optional. Discord application client secret.
DISCORD_REDIRECT_URI= # Optional. Must exactly match a redirect URI configured on the Discord application, and point at this backend's GET /api/account/discord/callback.
VAPID_PUBLIC_KEY= # Optional. Web push VAPID public key (base64url, no padding). Generate both VAPID_* keys with `npx web-push generate-vapid-keys`. Leave any of the three VAPID_* vars unset to keep web push disabled (503).
VAPID_PRIVATE_KEY= # Optional. Web push VAPID private key (base64url, no padding). Keep secret.
VAPID_SUBJECT= # Optional. Contact URI the push service can reach you at if it needs to, e.g. mailto:admin@example.com.
